<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.varun-51</groupId>
        <artifactId>recursive</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>recursive-packaging</artifactId>
    <name>Recursive Packaging</name>
    <description>jpackage configuration, app icons, and installer artifacts.</description>

    <properties>
        <skip.jpackage>true</skip.jpackage>
        <!-- APP_IMAGE works without a platform installer toolchain; the CI
             workflow overrides this with INSTALLER for the per-OS artifacts. -->
        <jpackage.type>APP_IMAGE</jpackage.type>
        <jpackage.installDir></jpackage.installDir>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.varun-51</groupId>
            <artifactId>recursive-app</artifactId>
            <version>${recursive.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.panteleyev</groupId>
                <artifactId>jpackage-maven-plugin</artifactId>
                <version>1.7.4</version>
                <configuration>
                    <skip>${skip.jpackage}</skip>
                    <debug>true</debug>
                    <force>true</force>
                    <type>${jpackage.type}</type>
                    <installDir>${jpackage.installDir}</installDir>
                    <name>Recursive</name>
                    <vendor>Varun Nakar</vendor>
                    <input>../recursive-app/target</input>
                    <mainJar>recursive-app-${recursive.version}.jar</mainJar>
                    <icon>src/main/resources/icons/icon.ico</icon>
                    <mainClass>com.recursive.app.GuiLauncher</mainClass>
                    <destination>target/dist</destination>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>jpackage</goal>
                        </goals>
                        <phase>package</phase>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
